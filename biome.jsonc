{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // The mod's code and its tests only: never Herdr's *.d.ts or jsconfig.json, fixtures, SVG or JSON.
    "includes": ["mods/**/*.js", "tests/**/*.mjs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  // Import order stays as written.
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Node never loads ui/, so a name lost in a split would otherwise only show in Herdr.
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["mods/**"],
      "linter": {
        "rules": {
          "style": {
            // fs/promises is Herdr's module, not Node's: a node: prefix would break the import.
            "useNodejsImportProtocol": "off"
          }
        }
      }
    },
    {
      "includes": ["mods/wickline/quotes.js", "mods/wickline/settings.js"],
      "linter": {
        "rules": {
          "suspicious": {
            // The regexes match control characters on purpose: to strip them from what sources send and keys typed.
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["mods/wickline/watchlist.js"],
      "linter": {
        "rules": {
          "suspicious": {
            // `(record[key] ??= {})` creates a per-symbol entry where it is first used; unrolled it reads the map twice.
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/hygiene.test.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            // Its strings are sample source text with `${...}` for the scanner to read, never templates.
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/watchlist.test.mjs"],
      "linter": {
        "rules": {
          "complexity": {
            // `!q.book || q.book.bids…` tests truthiness; an optional chain tests only null and undefined.
            "useOptionalChain": "off"
          }
        }
      }
    }
  ]
}

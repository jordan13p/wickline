{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // The mod's code and its tests only: never Herdr's *.d.ts or jsconfig.json, fixtures, SVG or JSON.
    "includes": ["mods/**/*.js", "tests/**/*.mjs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  // Import order stays as written.
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        // Node never loads ui/, so a name lost in a split would otherwise only show in Herdr.
        "noUndeclaredVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["mods/**"],
      "linter": {
        "rules": {
          "style": {
            // fs/promises is Herdr's module, not Node's: a node: prefix would break the import.
            "useNodejsImportProtocol": "off"
          }
        }
      }
    }
  ]
}
